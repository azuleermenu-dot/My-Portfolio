# Required for the contact form's email delivery.
# Create a Resend API key and verify the sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Asnor Ali Portfolio <hello@your-verified-domain.com>"

# Recommended for a shared rate limit across Vercel serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
